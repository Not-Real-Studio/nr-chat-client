{
  "name": "@notrealstudio/nr-chat-client",
  "version": "0.6.0",
  "description": "Тонкий клиент nr-ui-protocol без зависимостей: createClient (сессии, ран по SSE через fetch, respond/cancel, профили, модели, auth) и createHttpBackend (ProtocolBackend поверх HTTP). Браузер и Node.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "node -e \"const p=require('./package.json');const bad=Object.entries({...p.dependencies,...p.peerDependencies}).filter(([,v])=>String(v).startsWith('file:'));if(bad.length){console.error('publish blocked: file: deps '+bad.map(([k])=>k).join(', '));process.exit(1)}\""
  },
  "peerDependencies": {
    "@notrealstudio/nr-ui-protocol": "^0.28.0"
  },
  "peerDependenciesMeta": {
    "@notrealstudio/nr-ui-protocol": {
      "optional": true
    }
  },
  "devDependencies": {
    "@notrealstudio/nr-ui-protocol": "file:../nr-ui-protocol",
    "@types/node": "^24.19.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Not-Real-Studio/nr-chat-client.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
